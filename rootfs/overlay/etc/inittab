# BusyBox init for the Python Lab.

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mount -t devtmpfs devtmpfs /dev
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mount -t tmpfs tmpfs /dev/shm
::sysinit:/bin/mount -t tmpfs -o mode=1777 tmpfs /tmp
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# Loopback only (no network card): Flask apps serve http://127.0.0.1:<port>
::sysinit:/sbin/ip link set lo up
# The page's 9p filesystem at /mnt/9p (files are fetched over HTTP on first use):
#   /mnt/host -> 9p/host   files uploaded from (and downloaded to) the page
#   /opt/py   -> 9p/py     pandas, matplotlib, numpy ...
::sysinit:/bin/sh -c 'mount -t 9p -o trans=virtio,version=9p2000.L host9p /mnt/9p 2>/dev/null && chmod 777 /mnt/9p/host || echo "host9p: not available (pandas/matplotlib and file upload disabled)"'
# Forget the app preview of a previous boot (see /usr/local/bin/web)
::sysinit:/bin/rm -rf /mnt/9p/host/.web

# Serial console = terminal on the web page (and automated tests);
# VGA console kept as a spare root shell.
ttyS0::respawn:/sbin/lab-shell
tty1::respawn:-/bin/sh

::shutdown:/bin/umount -a -r
