#!/usr/bin/env python3
"""web: run a Flask app inside the lab and see its pages.

The lab's virtual machine has no network link to your browser.  While an app
runs, the web page shows it in the preview panel under the terminal (links
and forms work there too), and from the terminal you can use:

    web start [app.py]     start the app in the background; wait until ready.
                           Saving a .py, template or CSS file afterwards
                           restarts the app (and the preview) by itself.
    web restart            restart the app now
    web show [PATH]        show PATH (default /) in the page's preview panel
    web get [PATH]         request PATH and print the page as text
    web html [PATH]        print the raw HTML instead
    web save FILE [PATH]   save the page (CSS included) as /mnt/host/FILE,
                           then download FILE with the page's Download box
    web log                show the server's log (one line per request)
    web stop               stop the app

Examples:  web show '/?market=KOSPI'     web get /hello     web save report.html
"""
import base64
import html.parser
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

STATE = "/tmp/web-server"          # .pid, .bridge, .port, .log
LOG = STATE + ".log"
# Shared with the page over 9p (js/lab.js reads and writes /host/.web/):
#   server.json   written while an app runs: {port, app, started}
#   show.json     "web show": {path, seq}
#   req-<id>.json the page's requests: {method, path, body, type}
#   res-<id>.json the answers: {status, path, type, body | body64}
BRIDGE = "/mnt/host/.web"


def read_state(name):
    try:
        with open(f"{STATE}.{name}") as f:
            return f.read().strip()
    except OSError:
        return None


def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def running():
    pid = read_state("pid")
    return int(pid) if pid and alive(pid) else None


def base_url():
    port = read_state("port")
    if not port or not running():
        sys.exit("No server is running. Start one first: web start app.py")
    return f"http://127.0.0.1:{port}"


def request(base, path, method="GET", body=None, ctype=None):
    """Return (status, final path, content type, body bytes)."""
    if not path.startswith("/"):
        path = "/" + path
    data = body.encode() if isinstance(body, str) else body
    req = urllib.request.Request(base + path, data=data, method=method)
    if ctype:
        req.add_header("Content-Type", ctype)
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            final = urllib.parse.urlsplit(r.geturl())
            return r.status, final.path + (f"?{final.query}" if final.query else ""), \
                r.headers.get("Content-Type", ""), r.read()
    except urllib.error.HTTPError as e:
        return e.code, path, e.headers.get("Content-Type", ""), e.read()


def fetch(path):
    status, _, _, body = request(base_url(), path)
    return status, body.decode("utf-8", "replace")


def inline_assets(base, html_text):
    """Put the app's own CSS and images into the HTML, so it stands alone."""
    def css(m):
        href = m.group(1)
        if not href.startswith("/"):
            return m.group(0)
        status, _, _, body = request(base, href)
        return f"<style>\n{body.decode('utf-8', 'replace')}\n</style>" if status == 200 else m.group(0)

    def img(m):
        src = m.group(2)
        if not src.startswith("/"):
            return m.group(0)
        status, _, ctype, body = request(base, src)
        if status != 200:
            return m.group(0)
        return f'{m.group(1)}"data:{ctype or "image/png"};base64,{base64.b64encode(body).decode()}"'

    html_text = re.sub(r'<link[^>]*rel="stylesheet"[^>]*href="([^"]+)"[^>]*>', css, html_text)
    return re.sub(r'(<img[^>]*\ssrc=)"([^"]+)"', img, html_text)


class TextView(html.parser.HTMLParser):
    """HTML -> readable terminal text: headings, lines, table rows."""

    BLOCKS = {"p", "div", "h1", "h2", "h3", "h4", "header", "section", "li",
              "form", "small", "br", "tr", "table", "ul", "ol", "footer"}

    def __init__(self):
        super().__init__()
        self.lines, self.line, self.row = [], "", None
        self.skip = 0
        self.cell = None

    def flush(self):
        text = " ".join(self.line.split())
        if text:
            self.lines.append(text)
        self.line = ""

    def handle_starttag(self, tag, attrs):
        if tag in ("style", "script", "select", "title"):
            self.skip += 1
        elif tag == "tr":
            self.flush()
            self.row = []
        elif tag in ("td", "th") and self.row is not None:
            self.cell = ""
        elif tag in self.BLOCKS:
            self.flush()
        if tag in ("h1", "h2", "h3"):
            self.line += "# " if tag == "h1" else "## "

    def handle_endtag(self, tag):
        if tag in ("style", "script", "select", "title"):
            self.skip = max(0, self.skip - 1)
        elif tag in ("td", "th") and self.row is not None and self.cell is not None:
            self.row.append(" ".join(self.cell.split()))
            self.cell = None
        elif tag == "tr" and self.row is not None:
            self.lines.append(" | ".join(self.row))
            self.row = None
        elif tag in self.BLOCKS:
            self.flush()

    def handle_data(self, data):
        if self.skip:
            return
        if self.cell is not None:
            self.cell += data
        elif self.row is None:
            self.line += data

    def text(self):
        self.flush()
        return "\n".join(self.lines)


# ---------------------------------------------------------------- page bridge

def write_json(path, obj):
    """Write atomically: the page must never read half a file."""
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(obj, f, ensure_ascii=False)
    os.replace(tmp, path)


def remove(path):
    try:
        os.remove(path)
    except OSError:
        pass


def launch(app, cwd):
    """Start the app in the background (log appended to LOG); return it."""
    with open(LOG, "a") as log:
        proc = subprocess.Popen([sys.executable, "-u", app], cwd=cwd, stdout=log,
                                stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                start_new_session=True)
    with open(STATE + ".pid", "w") as f:
        f.write(str(proc.pid))
    return proc


def wait_ready(proc, offset, seconds=120):
    """Port once the app logs "Running on", or None if it exits first."""
    for _ in range(int(seconds / 0.3)):
        time.sleep(0.3)
        with open(LOG, encoding="utf-8", errors="replace") as f:
            f.seek(offset)
            out = f.read()
        m = re.search(r"Running on http://127\.0\.0\.1:(\d+)", out)
        if m:
            with open(STATE + ".port", "w") as f:
                f.write(m.group(1))
            return int(m.group(1))
        if proc.poll() is not None:
            return None
    return None


def log_since(offset, lines=30):
    with open(LOG, encoding="utf-8", errors="replace") as f:
        f.seek(offset)
        return "\n".join(f.read().rstrip().splitlines()[-lines:])


def stop_group(pid):
    """Stop an app started with launch() (it leads its own process group)."""
    try:
        os.killpg(pid, signal.SIGTERM)
    except OSError:
        return
    for _ in range(30):
        if not alive(pid):
            return
        time.sleep(0.1)
    try:
        os.killpg(pid, signal.SIGKILL)
    except OSError:
        pass


WATCHED = (".py", ".html", ".htm", ".css", ".js", ".jinja", ".j2")
SKIP_DIRS = {"__pycache__", "instance", ".venv", "venv", ".git", "node_modules"}


def snapshot(root):
    """{path: mtime} of the app's code, templates and static files."""
    files = {}
    for d, dirs, names in os.walk(root):
        dirs[:] = [x for x in dirs if x not in SKIP_DIRS and not x.startswith(".")]
        for n in names:
            if n.endswith(WATCHED):
                p = os.path.join(d, n)
                try:
                    files[p] = os.stat(p).st_mtime
                except OSError:
                    pass
        if len(files) > 2000:
            break
    return files


def bridge(port, app, cwd):
    """Answer the page's requests (req-*.json), and restart the app when its
    files change, until "web stop"."""
    state = {"port": int(port), "app": app, "started": time.time(), "state": "running"}
    server_json = os.path.join(BRIDGE, "server.json")

    def publish():
        write_json(STATE + ".state", state)
        try:
            write_json(server_json, state)
        except OSError:
            pass

    def quit_(*_):
        remove(server_json)
        remove(os.path.join(BRIDGE, "show.json"))
        sys.exit(0)

    signal.signal(signal.SIGTERM, quit_)
    try:
        os.makedirs(BRIDGE, exist_ok=True)
        for name in os.listdir(BRIDGE):
            remove(os.path.join(BRIDGE, name))
        has_page = True
    except OSError:
        has_page = False             # no 9p (e.g. a test without the page)
    publish()

    def restart(reason):
        nonlocal files
        state.update(state="restarting", message=reason)
        publish()
        stop_group(int(read_state("pid") or 0))
        with open(LOG, "a") as f:
            f.write(f"\n--- {reason}: restarting {os.path.basename(app)} ---\n")
        offset = os.path.getsize(LOG)
        proc = launch(app, cwd)
        new_port = wait_ready(proc, offset)
        files = snapshot(cwd)
        if new_port:
            state.update(port=new_port, started=time.time(), state="running", message=reason)
        else:
            state.update(state="error", message=log_since(offset))
        publish()

    files = snapshot(cwd)
    last_check = 0.0
    while True:
        now = time.time()
        # 1. Code changed (or "web restart"): restart the app.
        if now - last_check > 1.0:
            last_check = now
            if os.path.exists(STATE + ".restart"):
                remove(STATE + ".restart")
                restart("web restart")
            else:
                current = snapshot(cwd)
                if current != files:
                    time.sleep(0.5)                  # let the editor finish saving
                    changed = sorted({os.path.relpath(p, cwd) for p in set(current) ^ set(files)}
                                     | {os.path.relpath(p, cwd) for p in current
                                        if p in files and current[p] != files[p]})
                    restart(f"{', '.join(changed[:3])} changed")
                elif state["state"] == "running" and not alive(read_state("pid")):
                    state.update(state="error", message=log_since(max(0, os.path.getsize(LOG) - 4000)))
                    publish()
        # 2. The page's requests.
        if not has_page:
            time.sleep(0.3)
            continue
        try:
            names = sorted(os.listdir(BRIDGE))
        except OSError:
            names = []
        base = f"http://127.0.0.1:{state['port']}"
        for name in names:
            full = os.path.join(BRIDGE, name)
            try:
                if name.startswith("res-") and now - os.path.getmtime(full) > 60:
                    remove(full)     # answers the page has had time to read
            except OSError:
                pass
            if not (name.startswith("req-") and name.endswith(".json")):
                continue
            try:
                with open(full, encoding="utf-8") as f:
                    req = json.load(f)
            except (OSError, ValueError):
                continue             # still being written
            remove(full)
            answer = os.path.join(BRIDGE, "res-" + name[4:])
            try:
                status, final, ctype, body = request(
                    base, req.get("path", "/"), req.get("method", "GET"),
                    req.get("body"), req.get("type"))
                res = {"status": status, "path": final, "type": ctype}
                if ctype.startswith("text/html"):
                    res["body"] = inline_assets(base, body.decode("utf-8", "replace"))
                elif ctype.startswith("text/") or "json" in ctype:
                    res["body"] = body.decode("utf-8", "replace")
                else:
                    res["body64"] = base64.b64encode(body).decode()
            except Exception as e:   # the app crashed or refused: tell the page
                res = {"status": 0, "path": req.get("path", "/"), "type": "text/plain",
                       "body": f"Could not reach the app: {e}"}
            write_json(answer, res)
        time.sleep(0.15)


# ---------------------------------------------------------------- commands

def cmd_start(args):
    app = args[0] if args else "app.py"
    if running():
        sys.exit(f"A server is already running ({base_url()}). Stop it first: web stop")
    if not os.path.exists(app):
        sys.exit(f"No {app} in {os.getcwd()}")
    app, cwd = os.path.abspath(app), os.getcwd()
    open(LOG, "w").close()
    remove(STATE + ".restart")
    print(f"Starting {os.path.basename(app)} (Flask takes about 10 seconds to load) ...", flush=True)
    proc = launch(app, cwd)
    port = wait_ready(proc, 0)
    if not port:
        print(log_since(0))
        sys.exit(f"{os.path.basename(app)} stopped before the server was ready"
                 + (f" (exit {proc.returncode})" if proc.poll() is not None else ""))
    b = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_bridge", str(port), app, cwd],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    with open(STATE + ".bridge", "w") as f:
        f.write(str(b.pid))
    print(f"Ready: http://127.0.0.1:{port} — shown in the preview panel under the terminal.")
    print("       Saving a .py, template or CSS file restarts the app by itself.")
    print("       web get /  ·  web show /  ·  web restart  ·  web stop")


def cmd_restart(args):
    bridge_pid = read_state("bridge")
    if not (bridge_pid and alive(bridge_pid)):
        sys.exit("No server is running. Start one first: web start app.py")
    before = os.path.getmtime(STATE + ".state") if os.path.exists(STATE + ".state") else 0
    open(STATE + ".restart", "w").close()
    print("Restarting ...", flush=True)
    for _ in range(500):
        time.sleep(0.3)
        try:
            if os.path.getmtime(STATE + ".state") > before:
                with open(STATE + ".state") as f:
                    st = json.load(f)
                if st["state"] == "running":
                    print(f"Ready: http://127.0.0.1:{st['port']}")
                    return
                if st["state"] == "error":
                    print(st.get("message", ""))
                    sys.exit("The app did not start. Fix the error and save; it restarts by itself.")
        except (OSError, ValueError):
            pass
    sys.exit("The app did not restart within 2 minutes; see: web log")


def cmd_show(args):
    base_url()
    path = args[0] if args else "/"
    if not path.startswith("/"):
        path = "/" + path
    try:
        write_json(os.path.join(BRIDGE, "show.json"), {"path": path, "seq": time.time()})
    except OSError:
        sys.exit("The preview panel is not available here (no /mnt/host).")
    print(f"Showing {path} in the preview panel.")


def cmd_get(args, raw=False):
    status, body = fetch(args[0] if args else "/")
    print(f"HTTP {status}")
    if raw:
        print(body)
    else:
        view = TextView()
        view.feed(body)
        print(view.text())


def cmd_save(args):
    if not args:
        sys.exit("usage: web save FILE [PATH]")
    name, path = args[0], (args[1] if len(args) > 1 else "/")
    status, body = fetch(path)
    body = inline_assets(base_url(), body)
    target = name if "/" in name else os.path.join("/mnt/host", name)
    with open(target, "w", encoding="utf-8") as f:
        f.write(body)
    print(f"HTTP {status} — saved {target} ({len(body.encode())} bytes)")
    if target.startswith("/mnt/host/"):
        print(f"Download it: type {target[len('/mnt/host/'):]} in the page's Download box (받기).")


def cmd_log(args):
    try:
        with open(LOG) as f:
            print(f.read().rstrip())
    except OSError:
        print("No server log yet.")


def cmd_stop(args):
    # The bridge first: it may be restarting the app (and changing its pid).
    bridge_pid = read_state("bridge")
    if bridge_pid and alive(bridge_pid):
        os.kill(int(bridge_pid), signal.SIGTERM)
        for _ in range(50):
            if not alive(bridge_pid):
                break
            time.sleep(0.1)
    pid = running()
    for name in ("server.json", "show.json"):
        remove(os.path.join(BRIDGE, name))
    if not pid:
        print("No server is running.")
    else:
        stop_group(pid)
        print("Server stopped.")
    for name in ("pid", "port", "bridge", "state", "restart"):
        remove(f"{STATE}.{name}")


def main():
    if len(sys.argv) >= 5 and sys.argv[1] == "_bridge":
        bridge(sys.argv[2], sys.argv[3], sys.argv[4])
        return
    cmds = {"start": cmd_start, "restart": cmd_restart, "show": cmd_show, "get": cmd_get,
            "html": lambda a: cmd_get(a, raw=True), "save": cmd_save,
            "log": cmd_log, "stop": cmd_stop}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__.strip())
        sys.exit(0 if len(sys.argv) < 2 else 2)
    cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    main()
